#!/bin/bash

SERVICE_NAME="caroubot"
SERVICE_FILE="/etc/systemd/system/${SERVICE_NAME}.service"
LOG_FILE="monitor.log"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper functions
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

check_systemd() {
    if [ ! -f "$SERVICE_FILE" ]; then
        log_error "Service file not found at $SERVICE_FILE"
        log_info "Run: ./setup.sh to create the systemd service"
        exit 1
    fi
}

start_service() {
    check_systemd
    log_info "Starting ${SERVICE_NAME}..."
    sudo systemctl daemon-reload
    sudo systemctl start ${SERVICE_NAME}

    sleep 1
    if systemctl is-active --quiet ${SERVICE_NAME}; then
        log_info "✓ ${SERVICE_NAME} started successfully"
        systemctl status ${SERVICE_NAME} --no-pager
    else
        log_error "Failed to start ${SERVICE_NAME}"
        systemctl status ${SERVICE_NAME} --no-pager
        exit 1
    fi
}

stop_service() {
    check_systemd
    log_info "Stopping ${SERVICE_NAME}..."
    sudo systemctl stop ${SERVICE_NAME}

    sleep 1
    if ! systemctl is-active --quiet ${SERVICE_NAME}; then
        log_info "✓ ${SERVICE_NAME} stopped successfully"
    else
        log_error "Failed to stop ${SERVICE_NAME}"
        exit 1
    fi
}

status_service() {
    check_systemd
    log_info "Status of ${SERVICE_NAME}:"
    systemctl status ${SERVICE_NAME} --no-pager
}

restart_service() {
    check_systemd
    log_info "Restarting ${SERVICE_NAME}..."
    sudo systemctl daemon-reload
    sudo systemctl restart ${SERVICE_NAME}

    sleep 1
    if systemctl is-active --quiet ${SERVICE_NAME}; then
        log_info "✓ ${SERVICE_NAME} restarted successfully"
        systemctl status ${SERVICE_NAME} --no-pager
    else
        log_error "Failed to restart ${SERVICE_NAME}"
        systemctl status ${SERVICE_NAME} --no-pager
        exit 1
    fi
}

show_logs() {
    if [ ! -f "$LOG_FILE" ]; then
        log_error "Log file not found at $LOG_FILE"
        exit 1
    fi

    if [ -n "$1" ]; then
        tail -f "$LOG_FILE" | head -n "$1"
    else
        tail -f "$LOG_FILE"
    fi
}

enable_on_boot() {
    check_systemd
    log_info "Enabling ${SERVICE_NAME} to start on boot..."
    sudo systemctl enable ${SERVICE_NAME}
    log_info "✓ ${SERVICE_NAME} will start on boot"
}

disable_on_boot() {
    check_systemd
    log_info "Disabling ${SERVICE_NAME} from starting on boot..."
    sudo systemctl disable ${SERVICE_NAME}
    log_info "✓ ${SERVICE_NAME} will not start on boot"
}

show_usage() {
    cat << EOF
Usage: ./caroubot COMMAND

Commands:
  start              Start the caroubot service
  stop               Stop the caroubot service
  restart            Restart the caroubot service
  status             Show service status
  logs [lines]       Show logs (follow live, optionally limit to N lines)
  enable             Enable service to start on boot
  disable            Disable service from starting on boot
  help               Show this help message

Examples:
  ./caroubot start
  ./caroubot stop
  ./caroubot status
  ./caroubot logs 50
EOF
}

# Main script
case "${1:-help}" in
    start)
        start_service
        ;;
    stop)
        stop_service
        ;;
    restart)
        restart_service
        ;;
    status)
        status_service
        ;;
    logs)
        show_logs "$2"
        ;;
    enable)
        enable_on_boot
        ;;
    disable)
        disable_on_boot
        ;;
    help|--help|-h)
        show_usage
        ;;
    *)
        log_error "Unknown command: $1"
        echo ""
        show_usage
        exit 1
        ;;
esac
